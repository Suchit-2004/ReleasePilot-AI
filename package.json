{
  "name": "releasepilot-ai",
  "version": "1.0.0",
  "private": true,
  "description": "AI-powered deployment-log diagnostics for Copado release workflows",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test",
    "analyze:sample": "node --env-file-if-exists=.env src/analyzer.js"
  },
  "engines": {
    "node": ">=24"
  }
}